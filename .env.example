# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"

# Server & Runtime Configuration
PORT=3000
NODE_ENV=production
JWT_SECRET=super_secure_luxe_jwt_secret_key_change_in_production_min_32_chars
FRONTEND_URL=http://localhost:3000

# MySQL Database Configuration
DATABASE_URL=mysql://root:password@localhost:3306/luxe_ecommerce
DB_HOST=localhost
DB_PORT=3306
DB_NAME=luxe_ecommerce
DB_USER=root
DB_PASSWORD=

# Payment Gateways (Stripe & PayPal)
STRIPE_SECRET_KEY=sk_test_51...
STRIPE_PUBLISHABLE_KEY=pk_test_51...
PAYPAL_CLIENT_ID=client_id_here
PAYPAL_SECRET=secret_key_here

# Mail & Notification Services (Optional for SMTP / WhatsApp integration)
SMTP_HOST=smtp.mailgun.org
SMTP_PORT=587
SMTP_USER=postmaster@example.com
SMTP_PASS=password
SMTP_FROM=support@luxecommerce.com

